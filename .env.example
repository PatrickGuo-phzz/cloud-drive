# ===== 数据库（Postgres）=====
# Vercel 部署：在控制台 Storage 创建 Postgres 并连接项目后自动注入，无需手动填写。
# 本地开发：填一个 PostgreSQL 连接串（本地 Docker 或任意云端库均可）。
# POSTGRES_URL 与 DATABASE_URL 配一个即可，程序会自动识别。
POSTGRES_URL=
# DATABASE_URL=

# ===== 文件存储（Vercel Blob）=====
# Vercel 部署：在控制台 Storage 创建 Blob 并连接项目后自动注入。
# 本地开发：可在 Vercel 控制台 Blob 存储页复制该 Token。
BLOB_READ_WRITE_TOKEN=
